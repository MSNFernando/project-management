# Database configuration
DB_NAME=springpm
DB_USER=springpm_user
DB_PASSWORD=springpm_password
DB_HOST=postgres
DB_PORT=5432

# MinIO configuration
MINIO_USER=springpm-dev
MINIO_PASSWORD=springpm_password
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Admin configuration
# Use https://jwtsecrets.com/ to generate a secure 32-character (128bits) secret for JWT_SECRET in production
# Usehttps://jwtsecrets.com/tools/api-key-generator to generate a secure 32-character secret for ADMIN_API_KEY in production
ADMIN_API_KEY=dev-jwt-secret-change-me-in-prod-must-be-32chars!
ADMIN_EMAIL=admin@springpm.com
ADMIN_PASSWORD=Admin1234!
LOGGING_LEVEL_COM_SPRINGPM=DEBUG# Choose from: DEBUG, INFO, WARN, ERROR
JWT_SECRET=dev-jwt-secret-change-me-in-prod-must-be-32chars!
SERVER_PORT=8080

REFRESH_TOKEN_EXPIRATION_HOURS=24
UPLOAD_DIR=./uploads

# https://jwtsecrets.com/tools/rsa-ec-key-generator
RSA_PUBLIC_KEY=
RSA_PRIVATE_KEY=

# Anthropic API (Optional - for AI features)
# Get your API key from: https://console.anthropic.com/
# Leave blank to disable AI features
ANTHROPIC_API_KEY=